{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f9f6f1", "$description": "Warm light canvas from the app-wide theme." },
      "foreground": { "$value": "#232e3e", "$description": "Deep slate text from the app-wide theme." },
      "border": { "$value": "#e3ddd4" },
      "card": { "$value": "#fdfdfc" },
      "cardForeground": { "$value": "#232e3e" },
      "popover": { "$value": "#fdfdfc" },
      "popoverForeground": { "$value": "#232e3e" },
      "primary": {
        "$value": "#3a8267",
        "$description": "App-wide sage primary. Marketing actions also use the nearby #397d63 brand highlight."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#efe9e1" },
      "secondaryForeground": { "$value": "#2c3a4e" },
      "muted": { "$value": "#f0ece6" },
      "mutedForeground": { "$value": "#6d7888" },
      "accent": { "$value": "#e1efea" },
      "accentForeground": { "$value": "#285845" },
      "destructive": { "$value": "#c33c32" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e3ddd4" },
      "ring": { "$value": "#3a8267" },
      "chart1": { "$value": "#3a8267" },
      "chart2": { "$value": "#d39845" },
      "chart3": { "$value": "#445c7e" },
      "chart4": { "$value": "#d17466" },
      "chart5": { "$value": "#589a9d" },
      "sidebar": { "$value": "#222d3f" },
      "sidebarForeground": { "$value": "#f3efe7" },
      "sidebarBorder": { "$value": "#3c4658" },
      "sidebarPrimary": { "$value": "#61b896" },
      "sidebarPrimaryForeground": { "$value": "#1a2332" },
      "sidebarAccent": { "$value": "#323e52" },
      "sidebarAccentForeground": { "$value": "#f6f4ee" },
      "sidebarRing": { "$value": "#61b896" }
    },
    "dark": {
      "background": { "$value": "#19212e" },
      "foreground": { "$value": "#f3efe7" },
      "border": { "$value": "#3c4658" },
      "card": { "$value": "#222b3a" },
      "cardForeground": { "$value": "#f3efe7" },
      "popover": { "$value": "#222b3a" },
      "popoverForeground": { "$value": "#f3efe7" },
      "primary": { "$value": "#61b896" },
      "primaryForeground": { "$value": "#171e2c" },
      "secondary": { "$value": "#323c4e" },
      "secondaryForeground": { "$value": "#f3efe7" },
      "muted": { "$value": "#2d3748" },
      "mutedForeground": { "$value": "#a1a9b5" },
      "accent": { "$value": "#2d493e" },
      "accentForeground": { "$value": "#b5dece" },
      "destructive": { "$value": "#d25951" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#3c4658" },
      "ring": { "$value": "#61b896" },
      "chart1": { "$value": "#61b896" },
      "chart2": { "$value": "#daa862" },
      "chart3": { "$value": "#8199bb" },
      "chart4": { "$value": "#d98d81" },
      "chart5": { "$value": "#83b7b9" },
      "sidebar": { "$value": "#131a25" },
      "sidebarForeground": { "$value": "#f3efe7" },
      "sidebarBorder": { "$value": "#303846" },
      "sidebarPrimary": { "$value": "#61b896" },
      "sidebarPrimaryForeground": { "$value": "#1a2332" },
      "sidebarAccent": { "$value": "#27303f" },
      "sidebarAccentForeground": { "$value": "#f6f4ee" },
      "sidebarRing": { "$value": "#61b896" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Default interface and body typeface."
      },
      "serif": {
        "$value": ["Manrope", "sans-serif"],
        "$description": "Display family for expressive product headlines; it is the sans-serif Manrope family."
      },
      "mono": {
        "$value": ["IBM Plex Mono", "monospace"],
        "$description": "Compact labels and numerical metadata."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius from the app theme; component radii derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
